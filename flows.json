    {
        "id": "mqtt_in_kelas",
        "type": "mqtt in",
        "z": "tab_kelas_hemat",
        "name": "Data ESP32",
        "topic": "kelas/uns-d3ti-kel2/c202/data",
        "qos": "0",
        "datatype": "json",
        "broker": "broker_hivemq_publik",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 240,
        "wires": [
            [
                "fn_pecah_data"
            ]
        ]
    },
    {
        "id": "fn_pecah_data",
        "type": "function",
        "z": "tab_kelas_hemat",
        "name": "Pecah data",
        "func": "var d = msg.payload;\n// Validasi token perangkat dari ESP32\nconst VALID_TOKEN = \"C202-KEL2-2026-AUTH\";\nif (!msg.payload || msg.payload.token !== VALID_TOKEN) {\n  node.warn(\"Akses ditolak: token perangkat tidak valid!\");\n  return null; // Hentikan pesan jika token salah/kosong\n}\nreturn [\n  { payload: d.status },\n  { payload: d.suhu },\n  { payload: d.lux },\n  { payload: d.lampu },\n  { payload: d.ac ? \"ON\" : \"OFF\" },\n  { payload: d.persen },\n  { payload: \"Rp \" + Math.round(d.rupiah).toLocaleString('id-ID') },\n  { payload: d.kwh_hemat.toFixed(4) + \" kWh\" },\n  [ { topic: \"Baseline\", payload: d.kwh_baseline }, { topic: \"Aktual\", payload: d.kwh_aktual } ],\n  { payload: [new Date().toISOString(), d.seq, d.status, d.pir, d.lux, d.suhu, d.lampu, d.ac, d.kwh_aktual, d.kwh_baseline, d.persen].join(\",\") + \"\\n\" }\n];",
        "outputs": 10,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 240,
        "wires": [
            [
                "ui_status"
            ],
            [
                "ui_suhu_gauge",
                "ui_suhu_chart"
            ],
            [
                "ui_lux_gauge",
                "ui_lux_chart"
            ],
            [
                "ui_lampu_gauge"
            ],
            [
                "ui_ac_text"
            ],
            [
                "ui_hemat_gauge"
            ],
            [
                "ui_rupiah_text"
            ],
            [
                "ui_kwh_text"
            ],
            [
                "ui_energi_bar"
            ],
            [
                "file_csv_riwayat"
            ]
        ]
    },
